<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Today & Month Countdown</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;

      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(135deg, #667eea, #764ba2);
    }

    .card {
      width: 100%;
      max-width: 520px;
      padding: 40px 30px;
      text-align: center;

      background: rgba(255, 255, 255, 0.95);
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }

    .label {
      margin-bottom: 10px;

      color: #777;
      font-size: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .date {
      margin-bottom: 35px;

      color: #222;
      font-size: clamp(2.2rem, 8vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
    }

    .month-end {
      color: #667eea;
      font-size: clamp(1.3rem, 5vw, 2rem);
      font-weight: 600;
    }

    .days {
      font-size: clamp(2rem, 7vw, 3.5rem);
      font-weight: 800;
      color: #764ba2;
    }

    @media (max-width: 480px) {
      .card {
        padding: 30px 20px;
        border-radius: 18px;
      }

      .date {
        margin-bottom: 25px;
      }
    }
  </style>
</head>

<body>

  <div class="card">
    <div class="label">Today:</div>
    <div class="date" id="today">--/--/----</div>

    <div class="label">End of month</div>
    <div class="month-end">
      <span class="days" id="daysLeft">--</span> days
    </div>
  </div>

  <script>
    function updateDate() {
      const today = new Date();

      // Format: dd/mm/yyyy
      const day = String(today.getDate()).padStart(2, "0");
      const month = String(today.getMonth() + 1).padStart(2, "0");
      const year = today.getFullYear();

      document.getElementById("today").textContent =
        `${day}/${month}/${year}`;

      // Get the last day of the current month
      const lastDay = new Date(
        today.getFullYear(),
        today.getMonth() + 1,
        0
      );

      // Calculate days remaining until the end of the month
      const daysLeft = lastDay.getDate() - today.getDate();

      document.getElementById("daysLeft").textContent = daysLeft;
    }

    updateDate();

    // Update automatically each day
    setInterval(updateDate, 60 * 60 * 1000);
  </script>

</body>
</html>
